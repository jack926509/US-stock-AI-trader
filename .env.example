# ─────────────────────────────────────────────────────────────
# 美股 AI 自動化交易系統 — 環境變數範本
# 用法：複製為 .env 後填入真實值；.env 不會被 git 追蹤
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@localhost:5432/trader

# ── Alpaca Paper Trading ─────────────────────────────────────
# https://app.alpaca.markets → Paper Trading → API Keys
ALPACA_KEY_ID=
ALPACA_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Anthropic（Claude API）───────────────────────────────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ── Webhook 安全 ──────────────────────────────────────────────
# TradingView alert_message JSON 裡需附帶此 secret
TRADINGVIEW_WEBHOOK_SECRET=請改成長隨機字串
# Python Engine 呼叫 /internal/python-signal 的驗證 token
INTERNAL_API_TOKEN=請改成長隨機字串

# ── Telegram Bot ──────────────────────────────────────────────
# 向 @BotFather 申請；chat_id 用 https://api.telegram.org/bot<TOKEN>/getUpdates 取得
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 業務參數（可調整不需動程式）──────────────────────────────
STOCK_POOL=AAPL,MSFT,NVDA,GOOGL,META,TSLA,AMD,AVGO,JPM,XOM
RISK_PCT_PER_TRADE=0.01
MAX_OPEN_POSITIONS=3
DAILY_LOSS_HALT_PCT=0.03
KELLY_MULTIPLIER=0.25
WIN_RATE_DEFAULT=0.50
AVG_RR_DEFAULT=1.5
PAPER_INITIAL_EQUITY=100000

# ── Python Engine ─────────────────────────────────────────────
PYTHON_SCAN_INTERVAL_MIN=5
NODE_INTERNAL_URL=http://localhost:8080/internal/python-signal

# ── 服務埠（local 開發用；Zeabur 上不需要設）──────────────────
API_PORT=8080
DASHBOARD_PORT=3000
